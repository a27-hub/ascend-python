From 9a27898b162782dadfbfea84e24dd5e9cb94c8cf Mon Sep 17 00:00:00 2001
From: huangchengnuo <huangchengnuo1@huawei.com>
Date: Sat, 25 Oct 2025 10:46:32 +0800
Subject: [PATCH] support dvm_module init

---
 CMakeLists.txt                                                | 1 +
 .../_inductor/ascend_npu_ir/ascend_npu_ir/npu/codegen/mlir.py | 4 ++--
 .../ascend_npu_ir/ascend_npu_ir/npu/mlir_compiler.py          | 3 +++
 torch_npu/csrc/InitNpuBindings.cpp                            | 2 ++
 4 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6b12fb061..b7406d439 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -313,6 +313,7 @@ target_link_libraries(${PLUGIN_NAME} PUBLIC ${TORCHNPU_THIRD_PARTY_ROOT}/acl/lib
 target_link_libraries(${PLUGIN_NAME} PUBLIC ${TORCHNPU_THIRD_PARTY_ROOT}/acl/libs/libacl_op_compiler.so)
 target_link_libraries(${PLUGIN_NAME} PUBLIC ${TORCHNPU_THIRD_PARTY_ROOT}/acl/libs/libge_runner.so)
 target_link_libraries(${PLUGIN_NAME} PUBLIC ${TORCHNPU_THIRD_PARTY_ROOT}/acl/libs/libgraph.so)
+target_link_libraries(${PLUGIN_NAME} PRIVATE ${TORCHNPU_THIRD_PARTY_ROOT}/op-plugin/op_plugin/ops/dvm/prebuild/aarch64/libdvm.a)
 
 if (DEFINED BUILD_TENSORPIPE)
   target_link_libraries(${PLUGIN_NAME} PUBLIC ${PROJECT_SOURCE_DIR}/build/packages/torch_npu/lib/libtensorpipe.so)
diff --git a/torch_npu/_inductor/ascend_npu_ir/ascend_npu_ir/npu/codegen/mlir.py b/torch_npu/_inductor/ascend_npu_ir/ascend_npu_ir/npu/codegen/mlir.py
index 2eb4d3b08..061dfe32c 100644
--- a/torch_npu/_inductor/ascend_npu_ir/ascend_npu_ir/npu/codegen/mlir.py
+++ b/torch_npu/_inductor/ascend_npu_ir/ascend_npu_ir/npu/codegen/mlir.py
@@ -297,8 +297,8 @@ class NpuMlirScheduling(SIMDScheduling):
             
             num_call_functions = get_num_call_functions(mlir_kernel._gm)
 
-            if num_call_functions <= 1 or kernel_name in anir_config.force_fallback_kernel_names:
-                mode = "complete_fallback"
+            # if num_call_functions <= 1 or kernel_name in anir_config.force_fallback_kernel_names:
+            mode = "complete_fallback"
             
             kernel_info = {}
 
diff --git a/torch_npu/_inductor/ascend_npu_ir/ascend_npu_ir/npu/mlir_compiler.py b/torch_npu/_inductor/ascend_npu_ir/ascend_npu_ir/npu/mlir_compiler.py
index 88498e348..09478aa91 100644
--- a/torch_npu/_inductor/ascend_npu_ir/ascend_npu_ir/npu/mlir_compiler.py
+++ b/torch_npu/_inductor/ascend_npu_ir/ascend_npu_ir/npu/mlir_compiler.py
@@ -25,6 +25,8 @@ from ..cache import get_cache_manager
 from .._C import load_kernel_binary
 from .codegen.cpp_wrapper import cpp_launcher
 
+from torch_npu.op_plugin.dvm.dvm_build import DvmBackend
+register_backend(name="dvm", compiler_fn=DvmBackend())
 
 reinterpret_tensor = torch.ops.inductor._reinterpret_tensor
 global_cache = set()
@@ -97,6 +99,7 @@ class NpuMlirCompiler:
         if Model is None:
             raise RuntimeError('Cannot find valid graph module!')
         model = Model()
+        model = torch.compile(model, backend="dvm")
         module_call = fx_graph_call(model, num_outputs)
         self.register_launcher(module_call, kernel_path=self.kernel_name + "_fx_fallback", is_fallback_kernel=True)
 
diff --git a/torch_npu/csrc/InitNpuBindings.cpp b/torch_npu/csrc/InitNpuBindings.cpp
index 694528dea..11e6c2ddc 100644
--- a/torch_npu/csrc/InitNpuBindings.cpp
+++ b/torch_npu/csrc/InitNpuBindings.cpp
@@ -152,6 +152,7 @@ void THNPEvent_init(PyObject *module);
 void THNPGraph_init(PyObject *module);
 void THNPMemPool_init(PyObject* module);
 void THNPShapeHandling_init(PyObject* module);
+void THDVM_init(PyObject* module);
 PyMethodDef* THNPModule_get_methods();
 
 static std::vector<PyMethodDef> methods;
@@ -194,6 +195,7 @@ PyObject* initModule()
     THNPGraph_init(module);
     THNPMemPool_init(module);
     THNPShapeHandling_init(module);
+    THDVM_init(module);
 
     RegisterNPUDeviceProperties(module);
     BindGetDeviceProperties(module);
-- 
2.43.0

